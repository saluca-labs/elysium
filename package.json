{
  "name": "@saluca/asphodel",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first agent memory: topic index, FTS, hybrid vector search (BM25 + embeddings + RRF), temporal decay",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "check:meta": "node scripts/check-package-meta.mjs saluca-labs/elysium"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "memory",
    "ai",
    "agent",
    "sqlite",
    "postgres",
    "mcp",
    "vector",
    "hybrid-search",
    "rrf",
    "embeddings",
    "asphodel",
    "elysium"
  ],
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saluca-labs/elysium.git"
  },
  "homepage": "https://github.com/saluca-labs/elysium#readme",
  "bugs": {
    "url": "https://github.com/saluca-labs/elysium/issues"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0"
  },
  "peerDependencies": {
    "node-llama-cpp": "^3.0.0",
    "pg": "^8.0.0",
    "sqlite-vec": "^0.1.0"
  },
  "peerDependenciesMeta": {
